name: Build Nexus Android APK

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: nexus-android-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Compile Nexus APK
    runs-on: ubuntu-latest

    steps:
      - name: Check out source
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.5'

      - name: Confirm retired Piper runtime is absent
        shell: bash
        run: |
          set -euo pipefail
          if grep -RniE 'piper|onnx|PiperEngine|AndroidPiperTest' \
            --exclude-dir=.git \
            --exclude-dir=.gradle \
            --exclude-dir=build \
            .; then
            echo 'Retired Piper/ONNX references found.' >&2
            exit 1
          fi
          echo 'No retired Piper/ONNX references found.'

      - name: Check Gradle installation
        run: gradle --version

      - name: Build debug APK
        run: gradle assembleDebug --no-daemon --stacktrace

      - name: Build release APK
        run: gradle assembleRelease --no-daemon --stacktrace

      - name: Upload debug APK
        uses: actions/upload-artifact@v4
        with:
          name: nexus-debug-apk
          if-no-files-found: error
          path: app/build/outputs/apk/debug/app-debug.apk
          retention-days: 14

      - name: Upload release APK
        uses: actions/upload-artifact@v4
        with:
          name: nexus-release-apk
          if-no-files-found: error
          path: app/build/outputs/apk/release/app-release-unsigned.apk
          retention-days: 14
