<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080D">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#05080D" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="#31D7FF"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#05080D"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/loadingLogo"
                android:layout_width="154dp"
                android:layout_height="154dp"
                android:contentDescription="Nexus triskelion"
                android:src="@drawable/nexus_triskelion"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.22"
                android:text="NEXUS"
                android:textColor="#E6F4FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="ECOSYSTEM INITIALIZATION"
                android:textColor="#6D8799"
                android:textSize="10sp" />

            <ProgressBar
                android:layout_width="124dp"
                android:layout_height="2dp"
                android:layout_marginTop="22dp"
                android:indeterminate="true"
                android:indeterminateTint="#31D7FF" />
        </LinearLayout>

    </FrameLayout>

</FrameLayout>
